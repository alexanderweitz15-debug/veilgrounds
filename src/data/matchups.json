  "relations": {
    "assassin>poke": {
      "de": "Poke-Magier haben keinen Fluchtweg gegen einen Sprung von hinten.",
      "en": "Poke mages have no escape from a dive."
    },
    "assassin>marksman": {
      "de": "Schützen sterben schnell, wenn die Assassine sie erreicht.",
      "en": "Marksmen die fast once the assassin reaches them."
    },
    "assassin>enchanter": {
      "de": "Enchanter sind weich und leicht zu überrumpeln.",
      "en": "Enchanters are squishy and easy to catch off guard."
    },
    "tank>assassin": {
      "de": "Rüstung und Leben machen den Burst der Assassine wirkungslos.",
      "en": "Armor and HP blunt the assassin's burst."
    },
    "tank>duelist": {
      "de": "Duellanten brechen sich an Rüstung und Leben die Zähne.",
      "en": "Duelists break their teeth on armor and HP."
    },
    "marksman>tank": {
      "de": "Prozentschaden und Dauerfeuer schmelzen Tanks.",
      "en": "Sustained and percent damage melts tanks."
    },
    "marksman>duelist": {
      "de": "Schützen kiten Nahkämpfer, bevor die ranspringen.",
      "en": "Marksmen kite melee fighters before they close in."
    },
    "engage>marksman": {
      "de": "Ein Engage erreicht den Schützen, bevor der fliehen kann.",
      "en": "An engage reaches the marksman before it can flee."
    },
    "engage>enchanter": {
      "de": "Enchanter ohne Peel fallen dem Engage zum Opfer.",
      "en": "Enchanters without peel fall to the engage."
    },
    "engage>poke": {
      "de": "Ein Engage schließt die Lücke, die Poke ausnutzt.",
      "en": "An engage closes the gap poke relies on."
    },
    "poke>tank": {
      "de": "Poke kiten langsame Tanks, ohne dass die ranreichen.",
      "en": "Poke kites slow tanks that never reach them."
    },
    "poke>duelist": {
      "de": "Duellanten erreichen Poke-Magier nicht, ohne vorher Leben zu verlieren.",
      "en": "Duelists lose HP before they can reach a poke mage."
    },
    "poke>enchanter": {
      "de": "Poke zwingt Enchanter zum Heilen statt zum Kämpfen.",
      "en": "Poke forces enchanters to heal instead of fight."
    },
    "control>engage": {
      "de": "Betäubung und Zonen stoppen das Engage.",
      "en": "Stuns and zones stop the engage."
    },
    "control>assassin": {
      "de": "Kontrolle fängt Assassinen im Sprung ab.",
      "en": "Crowd control catches assassins mid-dive."
    },
    "control>marksman": {
      "de": "Schützen stehen still und werden festgesetzt.",
      "en": "Marksmen stand still and get locked down."
    },
    "duelist>assassin": {
      "de": "Duellanten gewinnen den direkten Kampf gegen Assassinen.",
      "en": "Duelists win the straight fight against assassins."
    },
    "duelist>control": {
      "de": "Kontroll-Magier haben wenig Schutz im Nahkampf.",
      "en": "Control mages have little protection up close."
    },
    "enchanter>duelist": {
      "de": "Heilung und Schilde entschärfen Duellanten.",
      "en": "Heals and shields defuse duelists."
    },
    "enchanter>assassin": {
      "de": "Schilde und Peel fangen den Sprung auf den Schützen ab.",
      "en": "Shields and peel absorb the dive on the carry."
    },
    "tank>engage": {
      "de": "Tanks halten Engage-Champions aus und kontern mit mehr Leben.",
      "en": "Tanks outlast engage champions with more HP."
    },
    "control>duelist": {
      "de": "Duellanten brauchen Nähe, Kontrolle hält sie draußen.",
      "en": "Duelists need closeness, control keeps them out."
